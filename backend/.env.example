# Atom Backend Environment Configuration
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL=postgres://atom_user:atom_password@localhost:5432/atom_db?sslmode=disable

# JWT Authentication
JWT_SECRET=change-this-to-a-strong-random-secret-key

# Admin Seed Account (created on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=Admin User

# Server
PORT=8080
GIN_MODE=debug

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sandbox
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_MB=256
SANDBOX_WORKERS=3
